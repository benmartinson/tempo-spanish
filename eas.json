{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "PRODUCTION_BASE_URL": "https://your-api.example.com",
        "PRODUCTION_WS_URL": "wss://your-api.example.com/ws/transcribe"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
